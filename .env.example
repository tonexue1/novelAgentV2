# 复制为 .env 后填写（.env 已 gitignore）
# 所有键带 STORY_ 前缀，由 pydantic-settings 加载（见 story_engine/config.py）

# ── LLM（M2 选型：DeepSeek）────────────────────────────────
# mock = UT / 本地无网；openai = 走 OpenAI 兼容端点（含 DeepSeek）
STORY_LLM_PROVIDER=openai
STORY_LLM_MODEL=deepseek-v4-pro
STORY_OPENAI_API_KEY=
STORY_OPENAI_BASE_URL=https://api.deepseek.com
STORY_LLM_MAX_RETRIES=2
# 节点默认档在 story_engine/llm/node_profiles.py（dispatch/character/critic 等已 flash+关推理）
# 一键可查：uv run python -m story_engine.llm
# 可选覆盖（JSON）：
# STORY_LLM_NODE_MODELS={"writer":"deepseek-v4-flash"}
# STORY_LLM_NODE_THINKING={"planner":"disabled","architect":"enabled"}

# ── 运行时路径 ─────────────────────────────────────────────
STORY_DATA_DIR=./data
STORY_TELEMETRY_PATH=./data/runs.jsonl
STORY_GENESIS_MAX_ITER=3
